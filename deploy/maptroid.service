# systemd unit for maptroid.unrest.io. Canonical copy lives here; /etc/systemd/system/ holds a
# copy, not a symlink, so systemd can read it before /home is guaranteed mounted.
#   sudo cp /home/django/projects/maptroid/deploy/maptroid.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl restart maptroid
#
# Reload workers without a restart:  touch /home/django/projects/maptroid/server/uwsgi.ini   (or systemctl reload)

[Unit]
Description=maptroid.unrest.io uwsgi
After=network-online.target postgresql.service postgresql@16-main.service
Wants=network-online.target

[Service]
Type=simple
User=django
Group=django
WorkingDirectory=/home/django/projects/maptroid/server
ExecStartPre=/bin/mkdir -p /home/django/projects/maptroid/logs
ExecStart=/home/django/projects/maptroid/server/.venv/bin/uwsgi --ini /home/django/projects/maptroid/server/uwsgi.ini
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/django/projects/maptroid
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# 30G of media lives under server/.media and image work runs in-request.
MemoryMax=600M

[Install]
WantedBy=multi-user.target
